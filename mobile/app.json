{
  "expo": {
    "name": "LofiBuddha",
    "slug": "lofibuddha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lofibuddha",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08070C",
    "primaryColor": "#E4B872",
    "description": "Lofi music, guided meditation and breathwork for focus, calm and deep sleep.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lofibuddha.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.lofibuddha.app",
      "adaptiveIcon": {
        "backgroundColor": "#08070C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "LofiBuddha",
      "shortName": "LofiBuddha",
      "themeColor": "#08070C",
      "backgroundColor": "#08070C",
      "description": "Lofi music, guided meditation and breathwork for focus, calm and deep sleep.",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08070C"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "lofibuddha-mobile"
      }
    }
  }
}
