# ── Bodhi Dashboard — Environment Template ──
# Copy to .env.local and fill in your keys
# NEVER commit .env.local to git (already in .gitignore)

# DeepSeek — Content generation (settings page)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# App URL
NEXT_PUBLIC_APP_URL=https://lofibuddha.com

# TikTok API (OAuth) — Social scheduling
# Get from: https://developers.tiktok.com/apps/
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# OpenAI — Hermes agent + vision tasks (set in ~/.hermes/.env)
# OPENAI_API_KEY=sk-your-openai-key

# Gemini — Image generation fallback
# GEMINI_API_KEY=your-gemini-key
